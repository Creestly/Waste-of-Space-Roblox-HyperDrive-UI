		formatCoord(currentCoords[3]),
		formatCoord(currentCoords[4])
	}
	inPlanet = (currentCoords[5] == true)
end

-- Holds the actual numerical power required internally to prevent tag evaluation issues (`_`)
local currentRequiredPower = 0

-- Helper Function to safely convert strings with commas (like "3,000") to numbers 
local function parseNumber(val)
	if not val then return 0 end
	if type(val) == "number" then return val end
	local strClean = string.gsub(tostring(val), "[,%s]", "") -- Strip commas & spaces
	return tonumber(strClean) or 0
end

-- Setting UI properties via pure numbers completely bypasses Roblox text-filtering ("_"). 
local function safeSetText(ui, newText)
	local str = tostring(newText)
	if ui.Text ~= str then
		ui.Text = newText -- Passes the pure numerical type if provided, preventing the temporary tag `_`
	end
end

-- Function to apply strictly parsed strings to HyperDrive coordinates immediately
local function applyHyperDrive()
	-- Sub-helper: Replaces empty or incomplete hyphen fields with '0' for the HyperDrive 
	local function safeCoord(val)
		if val == "-" or val == "" then return "0" end
		return tostring(val)
	end

	local coordStr = string.format("%s, %s, %s, %s, %s", 
		safeCoord(fields[1]), safeCoord(fields[2]), safeCoord(fields[3]), safeCoord(fields[4]), tostring(inPlanet))

	if HyperDrive then
		HyperDrive.Coordinates = coordStr

		-- Spawned task allowing proper calculation delay
		task.spawn(function()
			task.wait(0.1)
			local reqPower = HyperDrive:GetRequiredPower()
			if reqPower then
				currentRequiredPower = parseNumber(reqPower)
				safeSetText(powerRequired1, currentRequiredPower)
			end
		end)
	end
end

local function updateFieldsUI()
	for i, btn in ipairs(coordButtons) do
		local textVal = fields[i]
		local num = tonumber(textVal)

		-- Bypass tagging using the pure number, but EXPLICITLY use string for "-0" and "-" to maintain display sign
		if textVal == "-" or textVal == "-0" or textVal == "" then
			safeSetText(btn, textVal)
		elseif num then
			safeSetText(btn, num)
		else
			safeSetText(btn, 0)
		end

		if i == currentSelection then
			btn.TextColor3 = Color3.fromHex("#FFFF00")
		else
			btn.TextColor3 = Color3.fromHex("#FFFFFF")
		end
	end
end

