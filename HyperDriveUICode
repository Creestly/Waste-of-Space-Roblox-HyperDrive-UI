local function appendDigit(digit)
	local currentText = fields[currentSelection]

	if isNegativePending then
		currentText = "-" .. digit
		isNegativePending = false
		textButton16.TextColor3 = Color3.fromHex("#FFFFFF")
		newInput = false
	elseif newInput then
		currentText = digit
		newInput = false
	else
		if currentText == "0" then
			currentText = digit
		elseif currentText == "-0" then
			currentText = "-" .. digit
		else
			currentText = currentText .. digit
		end
	end

	local val = tonumber(currentText) or 0
	local max = (currentSelection <= 2) and 100 or 10

	if val > max then
		currentText = tostring(max)
	elseif val < -max then
		currentText = tostring(-max)
	end

	fields[currentSelection] = currentText
	updateFieldsUI()
	applyHyperDrive() -- Updates HyperDrive immediately upon configuring
end

