-- Syncs our UI fields with whatever is currently written on the HyperDrive itself
local function syncFromHyperDrive()
	if HyperDrive and HyperDrive.Coordinates then
		local currentCoords = HyperDrive.Coordinates:ToArray()
		fields = {
			formatCoord(currentCoords[1]),
			formatCoord(currentCoords[2]),
			formatCoord(currentCoords[3]),
			formatCoord(currentCoords[4])
		}
		inPlanet = (currentCoords[5] == true)

		updateFieldsUI()
		updateInPlanetUI()

		-- Recalculate the required power reading 
		task.spawn(function()
			task.wait(0.1)
			local reqPower = HyperDrive:GetRequiredPower()
			if reqPower then
				currentRequiredPower = parseNumber(reqPower)
				safeSetText(powerRequired1, currentRequiredPower)
			end
		end)
	end
end

