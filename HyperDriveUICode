-- Helper function to preserve native "-0" natively (1/0 == inf, 1/-0 == -inf in Luau)
local function formatCoord(num)
	num = num or 0
	if num == 0 and (1 / num) < 0 then
		return "-0"
	end
	return tostring(math.floor(num))
end

